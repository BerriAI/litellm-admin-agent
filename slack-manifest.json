{
  "display_information": {
    "name": "LiteLLM Admin",
    "description": "Keys, teams and budgets for LiteLLM gateway admins. Message privately to get started.",
    "background_color": "#111827"
  },
  "features": {
    "bot_user": {
      "display_name": "LiteLLM Admin",
      "always_online": false
    },
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "im:history",
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "message.im"
      ]
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
