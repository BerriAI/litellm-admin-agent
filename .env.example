# Actual .env files must stay private and outside Git.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_WORKSPACE_ID=T04JBDEQSHF
# Use false during a migration until the previous listener is stopped.
SLACK_ENABLED=true

# Every caller needs the current LiteLLM proxy_admin role.
# SLACK_ADMIN_USER_IDS is obsolete and does not bypass the role check.
LITELLM_BASE_URL=https://gateway.litellm-sandbox.ai/v1
LITELLM_MODEL=openai/gpt-5.4
LITELLM_MCP_URL=https://gateway.litellm-sandbox.ai/personal_admin/mcp
LITELLM_MCP_ALIAS=personal_admin
ADMIN_TOOL_NAMES=

# Encrypts each admin’s saved personal credential. Preserve across deploys.
CREDENTIAL_ENCRYPTION_KEY=

# Hosted entry point. Generate a random service token (32+ characters).
ADMIN_AGENT_SERVICE_TOKEN=
# Render supplies RENDER_EXTERNAL_URL automatically; use AGENT_PUBLIC_URL elsewhere.
AGENT_PUBLIC_URL=
STATE_DB=data/events.sqlite3
PORT=10000
OPENAI_AGENTS_DISABLE_TRACING=1
