# Create .env with: python setup_env.py. Never commit a real .env.
# Create and install your own Slack app using slack-manifest.json.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_WORKSPACE_ID=
SLACK_ENABLED=true

# Use your gateway's HTTPS origin plus /v1 and a model name it actually exposes.
LITELLM_BASE_URL=https://gateway.example.com/v1
LITELLM_MODEL=
# Derived from LITELLM_BASE_URL unless overridden.
LITELLM_MCP_URL=
LITELLM_MCP_ALIAS=personal_admin
# Empty selects the shipped inventory. configure_mcp.py --write-tool-names
# writes the compatible subset from your gateway's OpenAPI spec.
ADMIN_TOOL_NAMES=

# api_key works without hosted gateway OAuth. Keys are entered only in the
# protected browser page. Set sso only after configuring a compatible gateway.
CONNECTION_AUTH_MODE=api_key
# Optional: set true to restrict the agent to read-only operations.
ADMIN_READ_ONLY=false

# setup_env.py generates unique values. Keep the encryption key across deploys.
CREDENTIAL_ENCRYPTION_KEY=
ADMIN_AGENT_SERVICE_TOKEN=
# A dedicated HTTPS origin (no subpath). Render supplies RENDER_EXTERNAL_URL.
AGENT_PUBLIC_URL=
STATE_DB=data/events.sqlite3
PORT=10000
MAX_PENDING_REQUESTS=8
QUEUE_TIMEOUT_SECONDS=30
RUN_TIMEOUT_SECONDS=180
OPENAI_AGENTS_DISABLE_TRACING=1
